# =============================================================================
# COTEL DECTlink - Configuración de Backups de Supabase
# =============================================================================
# Copiar este archivo a .env en el directorio scripts/
# o exportar las variables de entorno antes de ejecutar el script.
#
# Ejemplo de ejecución:
#   cd scripts
#   cp backups/.env.example .env
#   # Editar .env con tus credenciales
#   pnpm run backup

# -----------------------------------------------------------------------------
# Configuración de Supabase
# -----------------------------------------------------------------------------

# Referencia del proyecto Supabase (encontrar en: https://app.supabase.com/)
SUPABASE_PROJECT_REF=your-project-ref

# URL de conexión directa a la base de datos
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:[your-password]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Token de acceso de Supabase (opcional, para usar Supabase CLI)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# -----------------------------------------------------------------------------
# Configuración de Backups
# -----------------------------------------------------------------------------

# Directorio donde se guardarán los backups
BACKUP_DIR=./backups

# Días a conservar los backups (por defecto: 30)
BACKUP_RETAIN_DAYS=30

# Comprimir backups con gzip (true/false)
BACKUP_COMPRESS=true

# Cifrar backups (true/false) - requiere OpenSSL
BACKUP_ENCRYPT=false

# Clave de cifrado (solo si BACKUP_ENCRYPT=true)
BACKUP_ENCRYPTION_KEY=your-encryption-key

# -----------------------------------------------------------------------------
# Notificaciones por Email
# -----------------------------------------------------------------------------

# Habilitar notificaciones por email (true/false)
NOTIFY_EMAIL=false

# Configuración SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=backup@cotel.bo

# Destinatarios (separados por comas)
NOTIFY_EMAIL_TO=admin@cotel.bo,technical@cotel.bo

# -----------------------------------------------------------------------------
# Notificaciones por Slack
# -----------------------------------------------------------------------------

# Habilitar notificaciones por Slack (true/false)
NOTIFY_SLACK=false

# Webhook URL de Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# -----------------------------------------------------------------------------
# Notificaciones por Discord
# -----------------------------------------------------------------------------

# Habilitar notificaciones por Discord (true/false)
NOTIFY_DISCORD=false

# Webhook URL de Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# -----------------------------------------------------------------------------
# Almacenamiento Remoto
# -----------------------------------------------------------------------------

# Almacenamiento local (true/false)
STORAGE_LOCAL=true

# Ruta para almacenamiento local (opcional)
STORAGE_LOCAL_PATH=./backups

# Almacenamiento S3 (true/false)
STORAGE_S3=false

# Configuración S3
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=your-backup-bucket
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key
S3_REGION=us-west-2

# Almacenamiento Google Cloud Storage (true/false)
STORAGE_GCS=false

# Configuración GCS
GCS_BUCKET=your-backup-bucket
GCS_PROJECT_ID=your-gcp-project
GCS_KEY_FILE=path/to/service-account-key.json
