{
  "name": "@cotel/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "cotel-db": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:load": "tsx src/cli.ts load-consolidado",
    "db:check": "tsx src/cli.ts db-check",
    "db:verify": "tsx src/cli.ts db-verify",
    "db:clean": "tsx src/cli.ts cleanup-pruebas",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "smoke": "tsx src/cli.ts smoke",
    "copy:dist": "node scripts/copy-dist-to-backend.mjs",
    "dev": "tsx watch src/cli.ts",
    "backup": "tsx backups/supabaseBackup.ts",
    "backup:create": "tsx backups/supabaseBackup.ts",
    "backup:daily": "tsx backups/supabaseBackup.ts"
  },
  "dependencies": {
    "@cotel/types": "workspace:*",
    "commander": "^13.0.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.4",
    "dotenv": "^17.2.3",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}