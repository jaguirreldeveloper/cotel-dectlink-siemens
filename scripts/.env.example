# ⚠️ NO COMMIT THIS FILE TO VERSION CONTROL ⚠️
# Copiar a .env y configurar con tus credenciales
# Este archivo es para herramientas CLI (scripts/) y NO debe comitearse

# =============================================================================
# CONEXIÓN A BASE DE DATOS (para ETL y verificaciones)
# =============================================================================

# Cadena de conexión PostgreSQL completa
# Formato: postgres://user:password@host:port/database
# Ejemplo local: postgres://cotel:password@127.0.0.1:5432/cotel_dectlink
DATABASE_URL=

# Alternativa: credenciales individuales
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=cotel
SQL_PASSWORD=
SQL_DATABASE=cotel_dectlink

# Credenciales de administrador para Drizzle (opcional, para migraciones)
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# =============================================================================
# TOKEN DE SERVIDOR (para autenticación con el backend)
# =============================================================================

# Token administrativo para el header x-admin-token
# ⚠️ MISMO VALOR que ADMIN_TOKEN en backend/.env
ADMIN_TOKEN=

# Token explícito para smoke tests (opcional, prioritario sobre ADMIN_TOKEN)
# Usado en CI/despliegue contra backend remoto
SMOKE_ADMIN_TOKEN=

# =============================================================================
# CONFIGURACIÓN DE SMOKE TEST
# =============================================================================

# URL del backend para smoke tests
# Default: http://127.0.0.1:8010
SMOKE_URL=

# Número de líneas esperado en el padrón (opcional)
EXPECTED_LINES=

# =============================================================================
# SEGURIDAD
# =============================================================================

# Allowlist de hosts de BD (coma-separada, admite *)
# Ejemplo: localhost,127.0.0.1,*.pooler.supabase.com
ALLOWED_DB_HOSTS=localhost,127.0.0.1

# =============================================================================
# NOTAS DE SEGURIDAD
# =============================================================================
# 1. NUNCA comitees este archivo con valores reales
# 2. En producción, usa variables de entorno del sistema
# 3. ADMIN_TOKEN debe ser el MISMO en backend/.env y scripts/.env
# 4. Para CI/CD, configura estos valores como secrets del repositorio
# 5. El token de operador (Bearer) es diferente del ADMIN_TOKEN
#
# Para desarrollo local:
#   - Copia backend/.env.example a backend/.env y configura ADMIN_TOKEN
#   - Copia este archivo a scripts/.env con el mismo ADMIN_TOKEN
#   - Ejecuta: pnpm run smoke
#
# Para CI/CD:
#   - Configura SMOKE_ADMIN_TOKEN y DATABASE_URL como secrets
#   - No necesitas el archivo .env, usa variables de entorno
