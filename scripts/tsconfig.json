{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cotel/types": ["../packages/types/src"]
    },
    "allowImportingTsExtensions": true
  },
  "references": [
    { "path": "../packages/types" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "scripts", ".tsbuildinfo", "tests", "*.config.ts"]
}