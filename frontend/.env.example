# Frontend Environment Variables
# Copy to .env.local for local development

# API Target (backend Laravel)
VITE_API_TARGET=http://127.0.0.1:8010

# Los secretos de administración NO se exponen al frontend: las escrituras
# usan el token de la sesión del operador (Authorization: Bearer).

# Disable HMR (for AI Studio / low resource environments)
# DISABLE_HMR=true

# =============================================================================
# Sentry Configuration - Monitoreo de errores en producción
# =============================================================================
# Obtener DSN de: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACING_SAMPLE_RATE=0.2