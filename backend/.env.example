# =============================================================================
# COTEL DECTlink - Backend Laravel (Laravel Cloud)
# =============================================================================
# Plantilla de referencia para los entornos de Laravel Cloud. En Cloud los
# valores se configuran en la UI (Environment > Variables); aquí se documentan
# los que necesita la aplicación. Los marcados con [CLOUD] suelen inyectarse
# automáticamente por la plataforma.
#
# IMPORTANTE: el esquema de BD es el de COTEL (public.users, abonados_lineas,
# celdas, ...), NO el de Laravel. Por eso los drivers de sesión/cache/cola
# deben ser file/sync (o redis): NUNCA database, porque no existen las tablas
# sessions/cache/jobs/users de Laravel y no deben crearse.

APP_NAME="COTEL DECTlink"
APP_ENV=production
# APP_KEY: generar con `php artisan key:generate` o dejar que Cloud la inyecte.
APP_KEY=
APP_DEBUG=false
# URL pública de la app en Laravel Cloud (https://<app>.laravel.cloud).
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Base de datos: Supabase (PostgreSQL 17) - pooler transactional (IPv4)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.jeenkfugbqdmcxbwoefa
DB_PASSWORD=
# Si Cloud inyecta DATABASE_URL, la conexión pgsql la respeta.

# -----------------------------------------------------------------------------
# Sesiones / colas / caché (ver nota arriba: sin tablas de Laravel en la BD)
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# -----------------------------------------------------------------------------
# Realtime: SSE /api/events via pub/sub en Valkey (addon de Laravel Cloud)
# Redis solo transporta eventos SSE; la BD de sesión/caché NO usa redis.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
# En Cloud: REDIS_URL=redis://... (inyectado por el addon Valkey/Redis).
REDIS_URL=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

# -----------------------------------------------------------------------------
# Cache del Padrón - COTEL DECTlink
# -----------------------------------------------------------------------------
# Habilitar cache para el padrón (mejora rendimiento de /api/subscribers)
PADRON_CACHE_ENABLED=true
# TTL en minutos para el cache del padrón (por defecto: 5 minutos)
PADRON_CACHE_TTL_MINUTES=5

# -----------------------------------------------------------------------------
# Auth admin: mismo secreto que usaba el backend Express; el frontend lo envía
# en el header x-admin-token. Obligatorio: sin él las rutas admin responden 503.
# -----------------------------------------------------------------------------
ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Sentry Configuration - Monitoreo de errores en producción
# -----------------------------------------------------------------------------
# DSN (Data Source Name) de Sentry - obtener de: https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ENABLED=true
SENTRY_RELEASE=
SENTRY_TRACING_ENABLED=true
SENTRY_TRACING_SAMPLE_RATE=0.2
SENTRY_PERFORMANCE_ENABLED=true

# Sentry CLI (opcional, para despliegue)
SENTRY_CLI_DSN=
SENTRY_ORGANIZATION=
SENTRY_PROJECT=cotel-dectlink-siemens
SENTRY_AUTH_TOKEN=
