# ============================================
# COTEL DECTlink - Configuración Producción
# Sistema Industrial Siemens
# ============================================

# ====== APP CONFIGURATION ======
APP_NAME="COTEL DECTlink"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dectlink.cotel.bo
APP_TIMEZONE="America/La_Paz"

APP_KEY=base64:TuClaveDeAplicacionAqui1234567890ABCDEF==

# ====== DATABASE - Supabase PostgreSQL ======
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-west-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.[identificador]
DB_PASSWORD=[contraseña-segura-supabase]
DB_SSLMODE=require

# Opcional: Cadena completa de conexión
# DATABASE_URL="postgresql://postgres.[identificador]:[contraseña]@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ====== CACHE & SESSIONS ======
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ====== REDIS - Para SSE y cache ======
REDIS_URL=redis://default:[contraseña-redis]@[host-redis].upstash.io:6379
REDIS_CLIENT=phpredis

# ====== MAIL - Notificaciones ======
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@cotel.bo
MAIL_PASSWORD=[app-password-gmail]
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@cotel.bo"
MAIL_FROM_NAME="COTEL DECTlink"

# ====== ADMINISTRATIVE ======
# Token administrativo para CLI y servicios
ADMIN_TOKEN=ctel-prod-2026-secure-token-$(openssl rand -hex 16)

# ====== SECURITY ======
# Clave para encriptación de tokens JWT
JWT_SECRET=$(openssl rand -base64 32)

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_MAX_REQUESTS=100
RATELIMIT_DECAY_MINUTES=1

# CORS
CORS_ALLOWED_ORIGINS=["https://dectlink.cotel.bo", "https://admin.cotel.bo"]
CORS_ALLOWED_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
CORS_ALLOWED_HEADERS=["Content-Type", "Authorization", "X-Requested-With", "x-admin-token"]

# ====== LOGGING ======
LOG_CHANNEL=stack
LOG_STACK="single,daily,slack"
LOG_LEVEL=warning
LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ====== MONITORING ======
SENTRY_LARAVEL_DSN=https://[key]@sentry.io/[project]
NEW_RELIC_LICENSE_KEY=[license-key]
NEW_RELIC_APP_NAME="COTEL DECTlink Production"

# ====== FEATURE FLAGS ======
FEATURE_SSE_ENABLED=true
FEATURE_BATCH_UPLOADS=true
FEATURE_GPS_CALIBRATION=true
FEATURE_RF_SIMULATION=true
FEATURE_MIGRATION_PLANNER=true

# ====== PERFORMANCE ======
OPCACHE_ENABLED=true
COMPRESSION_ENABLED=true
ASSET_CACHE_TTL=31536000  # 1 año
API_RESPONSE_CACHE_TTL=300  # 5 minutos

# ====== TELEMETRY ======
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=https://telemetry.cotel.bo/api/v1/metrics

# ====== BACKUP ======
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM diario
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=cotel-backups-prod
BACKUP_S3_REGION=us-west-1

# ====== ALERTING ======
ALERT_EMAILS="tecnico@cotel.bo,sistemas@cotel.bo"
ALERT_SLACK_CHANNEL="#alerts-cotel"
ALERT_HEALTH_CHECK_URL=https://health.cotel.bo/ping

# ====== AUDIT ======
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_SENSITIVE_FIELDS="password,token,secret_key"

# ====== INTEGRATIONS ======
SUPABASE_PROJECT_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

ATT_API_ENDPOINT=https://api.att.bo/v1
ATT_API_KEY=[att-api-key]

# ====== FRONTEND BUILD CONFIG ======
VITE_APP_URL=https://dectlink.cotel.bo
VITE_API_URL=https://dectlink.cotel.bo/api
# No definir VITE_ADMIN_TOKEN: los secretos no deben viajar en el bundle.
VITE_SUPABASE_URL=${SUPABASE_PROJECT_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ============================================
# INSTRUCCIONES:
# 1. Copiar este archivo como .env.production
# 2. Reemplazar valores entre []
# 3. Generar APP_KEY: php artisan key:generate --show
# 4. Generar JWT_SECRET: openssl rand -base64 32
# 5. Configurar Supabase: https://supabase.com/dashboard
# 6. Configurar Redis: Upstash o Redis Cloud
# ============================================