# Root Environment Variables
# Copy to .env for local development

# Database connection (for scripts: db:load, db:check, db:verify, db:clean, smoke)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Or use individual vars:
# SQL_HOST=host
# SQL_PORT=5432
# SQL_USER=user
# SQL_PASSWORD=password
# SQL_DB_NAME=database

# Admin credentials for drizzle-kit (separate from app credentials)
# SQL_ADMIN_USER=admin
# SQL_ADMIN_PASSWORD=admin_password

# Admin token for backend admin endpoints (also in backend/.env)
ADMIN_TOKEN=your-secure-admin-token

# Frontend build-time variables (injected at build)
VITE_API_TARGET=http://127.0.0.1:8010
VITE_ADMIN_TOKEN=your-secure-admin-token

# Disable HMR (for AI Studio / low resource environments)
# DISABLE_HMR=true

# Allowed database hosts for legacy Express (comma-separated, supports *)
# ALLOWED_DB_HOSTS=*.pooler.supabase.com,localhost