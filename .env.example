# ====================================================================
# COTEL R.L. - Sistema de Gestión de Planta Externa Siemens DECTlink
# Variables de entorno (copiar a .env y completar)
# ====================================================================

# Puerto del servidor Express (dev: vite middleware, prod: dist estático)
PORT=3000

# --- Conexión a la base de datos (elegir UNA de las dos opciones) ---

# Opción A: cadena completa (Supabase pooler o PostgreSQL con SSL)
#DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Opción B: credenciales individuales (Google Cloud SQL o PostgreSQL local)
#SQL_HOST=127.0.0.1
#SQL_PORT=5432
#SQL_USER=postgres
#SQL_PASSWORD=tu_password
#SQL_DB_NAME=cotel_dectlink

# Credenciales solo para drizzle-kit (npm run db:generate / db:push)
#SQL_ADMIN_USER=postgres
#SQL_ADMIN_PASSWORD=tu_password

# --- Seguridad administrativa ---

# Token obligatorio para los endpoints administrativos:
# consola SQL, test/apply de conexión, git init/remote y escrituras de abonados.
# Si no está definido, esos endpoints responden 503 (bloqueados).
# Generar con: openssl rand -hex 32
ADMIN_TOKEN=

# Token que el FRONTEND envía en el header x-admin-token (build time).
# Alternativamente, el operador puede ingresarlo en pantalla la primera vez.
VITE_ADMIN_TOKEN=

# Allowlist de hosts de bases de datos aceptados por test/apply-connection
# (separados por coma, admite comodines). Por defecto: solo Supabase.
#ALLOWED_DB_HOSTS=*.supabase.com,*.supabase.co,db.miempresa.com
