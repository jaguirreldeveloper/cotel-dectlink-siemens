# Root Environment Variables
# Copy to .env for local development
# ⚠️ NUNCA commitear este archivo con valores reales

# Database connection (for scripts: db:load, db:check, db:verify, db:clean, smoke)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Or use individual vars:
# SQL_HOST=host
# SQL_PORT=5432
# SQL_USER=user
# SQL_PASSWORD=password
# SQL_DB_NAME=database

# Admin credentials for drizzle-kit (separate from app credentials)
# SQL_ADMIN_USER=admin
# SQL_ADMIN_PASSWORD=admin_password

# ⚠️ SEGURIDAD: ADMIN_TOKEN solo debe estar en backend/.env o en variables de entorno
# NO exponer en archivos de frontend o scripts versionados
# ADMIN_TOKEN=your-secure-admin-token

# Frontend build-time variables (injected at build)
VITE_API_TARGET=http://127.0.0.1:8010
# ⚠️ NUNCA definir VITE_ADMIN_TOKEN: los secretos no deben viajar en el bundle del frontend.
# Los tokens administrativos solo se usan en backend y scripts CLI (Node.js)

# Disable HMR (for AI Studio / low resource environments)
# DISABLE_HMR=true

# Allowed database hosts for legacy Express (comma-separated, supports *)
# ALLOWED_DB_HOSTS=*.pooler.supabase.com,localhost

# =============================================================================
# para desarrollo local:
# 1. Copia este archivo a .env
# 2. Configura DATABASE_URL con tus credenciales
# 3. ADMIN_TOKEN debe estar en backend/.env (nunca en este archivo)
# 4. Para scripts: usa SMOKE_ADMIN_TOKEN como variable de entorno
